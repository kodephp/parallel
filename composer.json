{
    "name": "kode/parallel",
    "description": "适用于 PHP 8.3+ 的高性能并行并发库：多引擎自动降级（ext-parallel 真线程 / pcntl 多进程 / 同步回退），提供 Runtime、Task、Future、Channel、Events、Fiber、Sync、WorkerPool、Cluster 等完整能力与跨机器分布式任务执行",
    "keywords": [
        "parallel",
        "concurrency",
        "async",
        "multithreading",
        "multiprocess",
        "fiber",
        "coroutine",
        "cluster",
        "distributed",
        "kode",
        "高性能",
        "并行",
        "并发",
        "协程",
        "分布式",
        "跨机器"
    ],
    "type": "library",
    "version": "1.6.1",
    "license": "Apache-2.0",
    "authors": [
        {
            "name": "KodePHP",
            "email": "382601296@qq.com",
            "homepage": "https://github.com/kodephp"
        }
    ],
    "require": {
        "php": ">=8.3",
        "kode/context": "^2.0",
        "kode/facade": "^2.0",
        "kode/fibers": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "suggest": {
        "ext-parallel": "启用 parallel 引擎以获得真正的多线程并行（需要 ZTS 构建的 PHP）",
        "ext-pcntl": "启用 process 引擎，在无 ext-parallel 的类 UNIX 环境下提供多进程并行",
        "ext-posix": "配合 process 引擎实现子进程精确取消",
        "ext-sockets": "分布式集群通信"
    },
    "autoload": {
        "psr-4": {
            "Kode\\Parallel\\": "src/"
        },
        "files": [
            "src/functions.php",
            "src/Channel/functions.php",
            "src/Sync/functions.php",
            "src/Util/Php85.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Kode\\Parallel\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kode-parallel"
    ],
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "doctor": "php bin/kode-parallel doctor",
        "check": "php bin/kode-parallel doctor",
        "info": "php bin/kode-parallel info",
        "lint": "find src tests -name '*.php' -print0 | xargs -0 -n1 php -l > /dev/null && echo 'Lint OK'"
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
